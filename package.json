{
	"name": "llmspy",
	"version": "0.7.0",
	"description": "Local developer tool for intercepting and displaying LLM API traffic",
	"license": "MIT",
	"author": "piyook",
	"homepage": "https://llmspy.piyook.com/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/piyook/llmspy.git"
	},
	"bugs": {
		"url": "https://github.com/piyook/llmspy/issues"
	},
	"keywords": [
		"llm",
		"proxy",
		"anthropic",
		"openai",
		"claude",
		"debugging",
		"traffic",
		"devtools"
	],
	"private": true,
	"workspaces": [
		"proxy",
		"ui"
	],
	"scripts": {
		"dev": "concurrently -n proxy,ui -c blue,green \"npm:dev:proxy\" \"npm:dev:ui\"",
		"dev:proxy": "npm run dev -w proxy",
		"dev:ui": "npm run dev -w ui",
		"build": "npm run build --workspaces",
		"stage": "npm run build && node scripts/stage-package.mjs",
		"publish:npm": "npm run stage && npm publish .npm-package",
		"start": "npm start -w proxy",
		"stop": "tsx proxy/src/cli.ts stop",
		"start:docker": "docker compose up -d --build",
		"stop:docker": "docker compose down",
		"mock": "cd mock && concurrently -n anthropic,openai -c magenta,cyan \"llmock start --model=claude --foreground\" \"llmock start --model=chatgpt --port=8002 --foreground\"",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "npm run typecheck --workspaces",
		"test": "npm run test --workspaces --if-present",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npm run test:e2e -w proxy",
		"fallow": "fallow --coverage coverage/coverage-final.json",
		"fallow:audit": "fallow audit --base origin/main --coverage coverage/coverage-final.json",
		"validate-branch-name": "node scripts/validate-branch-name.mjs",
		"prepare": "husky",
		"torch": "torch-it"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@vitest/coverage-v8": "^5.1.0",
		"concurrently": "^10.0.7",
		"fallow": "^3.43.0",
		"husky": "^9.1.7",
		"llmock": "^3.14.0",
		"torch-it": "^3.0.1",
		"typescript": "^6.0.2"
	},
	"engines": {
		"node": ">=26"
	},
	"allowScripts": {
		"esbuild": false,
		"llmock": false
	}
}
