{
	"$schema": "./node_modules/fallow/schema.json",
	// Run by hand or read by tools, so nothing imports them:
	// `node scripts/mock-traffic.mjs`, the Svelte config that the Vite
	// plugin and svelte-check load, and the Vitest config `npm run test:e2e`
	// passes with --config.
	"supportEntry": [
		"scripts/mock-traffic.mjs",
		"ui/svelte.config.js",
		"proxy/vitest.e2e.config.ts"
	],
	// The docs site is its own package (docs/package.json, VitePress), outside
	// the workspaces: nothing in proxy/ or ui/ imports it.
	"ignorePatterns": ["docs/**"],
	"duplicates": {
		// The dark colour tokens in ui/src/app.css are written twice on
		// purpose: once under prefers-color-scheme and once under
		// [data-theme=dark]. CSS can not share one block between the two.
		// Either copy changing shows them again.
		// contentParts in the two OpenAI parsers opens the same way (string or
		// array, switch on the part type), but the cases are each API's own.
		"ignoredClones": ["dup:abd01391:2", "dup:9c74f950:2"]
	}
}
