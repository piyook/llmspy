{
	"defaultModel": "claude",
	"models": {
		"claude": {
			"name": "claude",
			"model": "claude-mock",
			"endpoint": "v1/messages",
			"responseType": "lorem",
			"maxLoremParas": 4,
			"responseRules": [
				{
					"match": "#tools",
					"in": "last",
					"content": [
						{
							"type": "text",
							"text": "Let me check the weather first."
						},
						{
							"type": "tool_use",
							"name": "get_weather",
							"input": { "city": "Paris" }
						}
					]
				},
				{
					"match": "sunny",
					"in": "last",
					"text": "Sunny and 24C: take the picnic to the park."
				},
				{
					"match": "#max-tokens",
					"in": "last",
					"text": "This reply was cut off before it could finish the",
					"stopReason": "max_tokens"
				},
				{
					"match": "#refusal",
					"in": "last",
					"text": "I can't help with that.",
					"stopReason": "refusal"
				},
				{
					"match": "#rate-limit",
					"in": "last",
					"fail": { "status": 429 }
				},
				{
					"match": "#stream-error",
					"in": "last",
					"fail": {
						"kind": "stream-error",
						"status": 529,
						"afterChunks": 2
					}
				},
				{
					"match": "#stream-drop",
					"in": "last",
					"fail": { "kind": "stream-drop", "afterChunks": 2 }
				}
			]
		},
		"chatgpt": {
			"name": "openai",
			"endpoint": "v1/chat/completions",
			"responseType": "lorem",
			"maxLoremParas": 4,
			"stream": false,
			"responseRules": [
				{
					"match": "#max-tokens",
					"in": "last",
					"text": "This reply was cut off before it could finish the",
					"stopReason": "max_tokens"
				},
				{
					"match": "#refusal",
					"in": "last",
					"text": "I can't help with that.",
					"stopReason": "refusal"
				},
				{
					"match": "#rate-limit",
					"in": "last",
					"fail": { "status": 429 }
				},
				{
					"match": "#stream-error",
					"in": "last",
					"fail": {
						"kind": "stream-error",
						"status": 500,
						"afterChunks": 2
					}
				},
				{
					"match": "#stream-drop",
					"in": "last",
					"fail": { "kind": "stream-drop", "afterChunks": 2 }
				}
			]
		}
	},
	"server": { "port": 8001, "host": "127.0.0.1" }
}
