# Copy to .env. Read by `docker compose` (npm run start:docker); local runs (npm start) do not load it.
# LLMSpy needs no API keys: apps send their own, and they are passed through to the upstream.

# Extra upstreams as name=url pairs, comma separated. The built-in anthropic and openai are always there.
# Inside the container, a service on your machine is host.docker.internal, not localhost.
# LLMSPY_UPSTREAMS=openrouter=https://openrouter.ai/api/v1,ollama=http://host.docker.internal:11434
